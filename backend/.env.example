# ---- Server ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- Database ----
DATABASE_URL=postgres://miniledger:miniledger@localhost:5432/miniledger

# ---- Auth ----
# Change this in any non-local environment.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=30d
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
DEFAULT_COUNTRY_CODE=91

# ---- Uploads ----
MAX_UPLOAD_BYTES=5242880
# UPLOAD_DIR=./uploads

# ---- Misc ----
LOG_LEVEL=info
